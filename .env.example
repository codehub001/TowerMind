# TowerMind Environment Configuration Example
# Copy this file to .env and set your keys. DO NOT commit .env to version control.

# OpenAI API Key (optional for LLM agent/advisor)
OPENAI_API_KEY=key

# Anthropic API Key (optional for LLM agent/advisor)
ANTHROPIC_API_KEY=key

# Google Gemini API Key (optional for LLM agent/advisor)
GEMINI_API_KEY=key

# Ollama Host (for local models, e.g. http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

